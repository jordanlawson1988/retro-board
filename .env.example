# Neon Postgres
DATABASE_URL=postgresql://...

# Which Neon branch DATABASE_URL points at. scripts/run-one.mjs refuses to run
# unless this is "dev" or --prod is passed.
NEON_BRANCH=dev

# Signs the per-board participant cookie (openssl rand -base64 32). Min 32 chars.
PARTICIPANT_SESSION_SECRET=

# Better Auth
BETTER_AUTH_SECRET=generate-via-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Ably (server-side only)
ABLY_API_KEY=

# Resend (transactional email)
RESEND_API_KEY=

# Cloudflare Turnstile (signup + login anti-bot)
# Site key is public; secret is server-only. Provision at:
# https://dash.cloudflare.com/?to=/:account/turnstile
# Set widget mode to "Managed" and include all domains (localhost, preview, prod).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
